PORT=5000
DATABASE_URL="postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/tema_concept"
JWT_SECRET="change_this_secret"
FRONTEND_URL="http://localhost:5173"
NODE_ENV=development

# IA locale via Ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_MS=120000

# Notifications email (Gmail / SMTP)
# Pour Gmail : activez la validation en 2 étapes, puis créez un "Mot de passe d'application"
# https://myaccount.google.com/apppasswords
# Utilisez le port 465 (587 est souvent bloqué par les FAI)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM=votre.adresse@gmail.com
CONTACT_NOTIFY_EMAIL=votre.adresse@gmail.com
